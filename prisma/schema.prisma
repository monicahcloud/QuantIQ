generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AcademicBoostLead {
  id String @id @default(cuid())

  parentName       String
  parentEmail      String
  parentPhone      String
  preferredContact String?

  studentName   String
  studentAge    String?
  gradeEntering String
  currentSchool String?

  programSelection String

  academicConcerns String[]
  academicNotes    String?
  parentGoals      String?
  medicalNotes     String?

  emergencyContactName  String
  emergencyContactPhone String

  consent Boolean @default(false)
  status  String  @default("new")
  source  String  @default("Website Form")

  formResponses Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EducatorProfile {
  id String @id @default(cuid())

  clerkUserId String  @unique
  email       String?

  firstName String?
  lastName  String?

  schoolName  String?
  teacherRole String?

  country       String?
  curriculum    String?
  examFocus     String?
  teachingGoals String?

  gradeLevels String[]
  subjects    String[]

  classSize Int?

  onboardingComplete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AuthorityType {
  MINISTRY
  DEPARTMENT
  BOARD
  DISTRICT
  REGION
  OTHER
}

enum OrganizationType {
  GOVERNMENT
  PRIVATE_NETWORK
  SCHOOL_BOARD
  DISTRICT
  RELIGIOUS_NETWORK
  CHARTER_NETWORK
  HOMESCHOOL_NETWORK
  INDEPENDENT
  OTHER
}

enum SchoolType {
  PRESCHOOL
  PRIMARY
  JUNIOR_HIGH
  SENIOR_HIGH
  ALL_AGE
  SPECIALIZED
  VOCATIONAL
  PRIVATE
  OTHER
}

enum EducationLevelCode {
  PRESCHOOL
  PRIMARY
  HIGH_SCHOOL
}

enum AcademicPeriodType {
  TERM
  SEMESTER
  QUARTER
  TRIMESTER
  OTHER
}

model Country {
  id String @id @default(cuid())

  name         String
  officialName String?
  iso2Code     String  @unique
  iso3Code     String  @unique
  slug         String  @unique

  defaultLocale   String       @default("en-BS")
  defaultTimeZone String?
  status          RecordStatus @default(ACTIVE)

  authorities     EducationAuthority[]
  organizations   Organization[]
  schools         School[]
  educationLevels EducationLevel[]
  gradeLevels     GradeLevel[]
  subjects        Subject[]
  academicYears   AcademicYear[]
  calendarEvents  CalendarEvent[]
  calendarSetting AcademicCalendarSetting?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
}

model EducationAuthority {
  id String @id @default(cuid())

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  name        String
  slug        String
  type        AuthorityType
  description String?
  websiteUrl  String?
  email       String?
  phone       String?
  status      RecordStatus  @default(ACTIVE)

  organizations  Organization[]
  schools        School[]
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([type])
  @@index([status])
}

model Organization {
  id String @id @default(cuid())

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  authorityId String?
  authority   EducationAuthority? @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  parentOrganizationId String?
  parentOrganization   Organization? @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)

  childOrganizations Organization[] @relation("OrganizationHierarchy")

  name        String
  slug        String
  type        OrganizationType
  description String?
  websiteUrl  String?
  email       String?
  phone       String?
  status      RecordStatus     @default(ACTIVE)

  schools        School[]
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([authorityId])
  @@index([parentOrganizationId])
  @@index([type])
  @@index([status])
}

model School {
  id String @id @default(cuid())

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  authorityId String?
  authority   EducationAuthority? @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  name        String
  slug        String
  schoolCode  String?
  type        SchoolType
  description String?

  islandOrRegion String?
  city           String?
  addressLine1   String?
  addressLine2   String?
  postalCode     String?

  websiteUrl String?
  email      String?
  phone      String?

  status         RecordStatus    @default(ACTIVE)
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, slug])
  @@unique([countryId, schoolCode])
  @@index([countryId])
  @@index([authorityId])
  @@index([organizationId])
  @@index([type])
  @@index([status])
}

model EducationLevel {
  id String @id @default(cuid())

  countryId String

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  name        String
  code        EducationLevelCode
  slug        String
  description String?
  sequence    Int
  status      RecordStatus       @default(ACTIVE)

  gradeLevels GradeLevel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, code])
  @@unique([countryId, slug])
  @@unique([countryId, sequence])
  @@index([countryId])
  @@index([status])
}

model GradeLevel {
  id String @id @default(cuid())

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  educationLevelId String
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)

  name         String
  code         String
  slug         String
  numericGrade Int?
  sequence     Int
  status       RecordStatus @default(ACTIVE)

  subjectMappings GradeSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, code])
  @@unique([countryId, slug])
  @@unique([countryId, sequence])
  @@index([countryId])
  @@index([educationLevelId])
  @@index([status])
}

model Subject {
  id String @id @default(cuid())

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  name        String
  code        String
  slug        String
  description String?
  sequence    Int
  status      RecordStatus @default(ACTIVE)

  gradeMappings GradeSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, code])
  @@unique([countryId, slug])
  @@unique([countryId, sequence])
  @@index([countryId])
  @@index([status])
}

model GradeSubject {
  id String @id @default(cuid())

  gradeLevelId String
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  isRequired Boolean      @default(true)
  sequence   Int?
  status     RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeLevelId, subjectId])
  @@index([gradeLevelId])
  @@index([subjectId])
  @@index([status])
}

model AcademicYear {
  id String @id @default(cuid())

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  name      String
  slug      String
  startDate DateTime
  endDate   DateTime

  isCurrent Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)

  periods        AcademicPeriod[]
  weeks          AcademicWeek[]
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@unique([countryId, slug])
  @@index([countryId])
  @@index([isCurrent])
  @@index([status])
}

model AcademicPeriod {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name      String
  code      String
  type      AcademicPeriodType @default(TERM)
  sequence  Int
  startDate DateTime
  endDate   DateTime
  status    RecordStatus       @default(ACTIVE)

  weeks AcademicWeek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, code])
  @@unique([academicYearId, sequence])
  @@index([academicYearId])
  @@index([status])
}

model AcademicWeek {
  id String @id @default(cuid())

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  academicPeriodId String?
  academicPeriod   AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)

  name       String
  weekNumber Int
  startDate  DateTime
  endDate    DateTime

  isInstructional Boolean      @default(true)
  notes           String?
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, weekNumber])
  @@index([academicYearId])
  @@index([academicPeriodId])
  @@index([isInstructional])
  @@index([status])
}

enum CalendarEventType {
  PUBLIC_HOLIDAY
  SCHOOL_HOLIDAY
  SCHOOL_BREAK
  PROFESSIONAL_DEVELOPMENT
  TEACHER_WORKDAY
  EXAM_PERIOD
  NATIONAL_ASSESSMENT
  PARENT_CONFERENCE
  ORIENTATION
  SPORTS_DAY
  CULTURAL_EVENT
  GRADUATION
  MINISTRY_EVENT
  SCHOOL_CLOSURE
  EMERGENCY_CLOSURE
  WEATHER_EVENT
  OTHER
}

enum CalendarEventScope {
  COUNTRY
  AUTHORITY
  ORGANIZATION
  SCHOOL
}

model CalendarEvent {
  id String @id @default(cuid())

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  authorityId String?
  authority   EducationAuthority? @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  title       String
  description String?

  eventType CalendarEventType
  scope     CalendarEventScope @default(COUNTRY)

  startDate DateTime
  endDate   DateTime
  allDay    Boolean  @default(true)

  isInstructional       Boolean @default(false)
  affectsPacing         Boolean @default(true)
  affectsForecast       Boolean @default(true)
  affectsAttendance     Boolean @default(false)
  affectsAssessments    Boolean @default(false)
  affectsLessonPlanning Boolean @default(true)

  color String?
  notes String?

  status RecordStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([academicYearId])
  @@index([authorityId])
  @@index([organizationId])
  @@index([schoolId])
  @@index([eventType])
  @@index([scope])
  @@index([startDate, endDate])
  @@index([status])
}

model AcademicCalendarSetting {
  id String @id @default(cuid())

  countryId String  @unique
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  weekStartsOn WeekStartDay @default(MONDAY)

  instructionalDays Int[] @default([1, 2, 3, 4, 5])

  defaultPeriodType AcademicPeriodType @default(TERM)

  defaultLocale   String @default("en-BS")
  defaultTimeZone String @default("America/Nassau")

  autoAssignWeeksToTerms       Boolean @default(true)
  outsideTermsNonInstructional Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WeekStartDay {
  MONDAY
  SUNDAY
}
